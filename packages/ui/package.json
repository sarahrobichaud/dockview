{
	"name": "@dockview/ui",
	"version": "1.0.0",
	"description": "",
	"keywords": [],
	"type": "module",
	"author": "",
	"license": "ISC",
	"scripts": {
		"build": "pnpm run build:ts && pnpm run build:css",
		"build:ts": "tsup",
		"build:css": "tailwindcss -i ./src/globals.css -o ./dist/globals.css --minify",
		"watch": "pnpm run '/^watch:.*/'",
		"watch:ts": "tsup --watch",
		"watch:css": "tailwindcss -i ./src/globals.css -o ./dist/globals.css --watch"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.0.13",
		"@types/node": "^22.10.10",
		"@types/react": "^18.2.20",
		"tailwindcss": "^4.0.13",
		"tsup": "^8.4.0"
	},
	"exports": {
		"./globals.css": "./dist/globals.css",
		"./util": {
			"types": "./components/lib/utils/index.d.ts",
			"import": "./components/lib/utils/index.js",
			"default": "./components/lib/utils/index.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"import": "./dist/components/index.js",
			"default": "./dist/components/index.js"
		},
		"./shad": {
			"types": "./dist/components/shad/index.d.ts",
			"import": "./dist/components/shad/index.js",
			"default": "./dist/components/shad/index.js"
		},
		"./hooks": {
			"types": "./dist/hooks/index.d.ts",
			"import": "./dist/hooks/index.js",
			"default": "./dist/hooks/index.js"
		},
		"./typography": {
			"types": "./dist/components/typography/index.d.ts",
			"import": "./dist/components/typography/index.js",
			"default": "./dist/components/typography/index.js"
		},
		"./icons": {
			"types": "./dist/components/icons/index.d.ts",
			"import": "./dist/components/icons/index.js",
			"default": "./dist/components/icons/index.js"
		}
	},
	"dependencies": {
		"@dockview/config-typescript": "workspace:^",
		"@hookform/resolvers": "^3.10.0",
		"@radix-ui/react-alert-dialog": "^1.1.6",
		"@radix-ui/react-dialog": "^1.1.6",
		"@radix-ui/react-dropdown-menu": "^2.1.6",
		"@radix-ui/react-label": "^2.1.2",
		"@radix-ui/react-separator": "^1.1.2",
		"@radix-ui/react-slot": "^1.1.2",
		"@radix-ui/react-tooltip": "^1.1.8",
		"@tailwindcss/cli": "^4.0.13",
		"@tanstack/react-table": "^8.20.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"embla-carousel-react": "^8.5.2",
		"lucide-react": "^0.479.0",
		"react": "^18.2.0",
		"react-hook-form": "^7.54.2",
		"tailwind-merge": "^3.0.2",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^3.24.1"
	}
}
