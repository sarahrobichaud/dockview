{
	"extends": "@dockview/config-typescript/tsconfig.node",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"sourceMap": true,
		"declarationMap": true,
		"lib": ["ESNext", "DOM"],
		"baseUrl": ".",
		"paths": {
			"@dockview/core/*": ["./src/*"],
		},
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"],
	"tsc-alias": {
		"verbose": false,
		"resolveFullExtensions": [".js", ".jsx", ".ts", ".tsx"],
		"resolveFullPaths": true
	}
}
