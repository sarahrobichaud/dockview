{
	"extends": "@dockview/config-typescript/tsconfig.library",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"lib": ["ESNext", "DOM"],
		"sourceMap": true,
		"declarationMap": true,
		"baseUrl": ".",
		"paths": {
			"~/*": ["src/*"]
		}
	},
	"tsc-alias": {
		"resolveFullPaths": true,
		"verbose": false,
		"resolveFullExtensions": [".js", ".jsx", ".ts", ".tsx"]
	},
	"include": ["src/**/*.ts"]
}
