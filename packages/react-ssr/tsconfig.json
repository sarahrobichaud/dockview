{
    "extends": "@dockview/config-typescript/tsconfig.node",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "baseUrl": ".",
        "jsx": "react-jsx",
        "lib": ["ESNext", "DOM"],
        "paths": {
            "~/*": ["src/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}