{
	"name": "backend",
	"scripts": {
		"build": "tsc && tsc-alias && npm run build:copy-views && npm run build:css && npm run build:client-script",
		"build:copy-views": "cp -r src/views dist/.",
		"build:css": "pnpm dlx tailwindcss -i ./src/assets/globals.css -o ./public/styles.css",
		"build:client-script": "node esbuild.config.mjs",
		"start": "node dist/server.js",
		"dev": "pnpm run \"/^watch:.*/\"",
		"watch:ts": "tsx watch ./src/server.ts",
		"watch:css": "npx tailwindcss -i ./src/assets/globals.css -o ./public/styles.css --watch",
		"watch:client-script": "node esbuild.config.mjs --dev",
		"types:generate-public": "dts-bundle-generator --project ./tsconfig.api.json -o ./dockview-api.d.ts src/types/public/public-api.ts",
		"types:generate-ws": "dts-bundle-generator --project ./tsconfig.api.json -o ./dockview-ws-lib.d.ts src/types/public/ws-lib.ts"
	},
	"type": "module",
	"dependencies": {
		"@dockview/core": "workspace:^",
		"@dockview/ui": "workspace:^",
		"@dockview/ws": "workspace:^",
		"@vue/server-renderer": "^3.5.13",
		"chalk": "^5.3.0",
		"clsx": "^2.1.1",
		"cors": "^2.8.5",
		"dockerode": "^4.0.4",
		"ejs": "^3.1.10",
		"express": "^4.21.0",
		"http-proxy": "^1.18.1",
		"morgan": "^1.10.0",
		"nanoid": "^5.0.7",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-syntax-highlighter": "^15.6.1",
		"reflect-metadata": "^0.2.2",
		"semver": "^7.6.3",
		"tar-fs": "^3.0.8",
		"tsc-alias": "^1.8.10",
		"tsyringe": "^4.8.0",
		"vhost": "^3.0.2",
		"vue": "^3.5.13",
		"vue-router": "^4.5.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/dockerode": "^3.3.34",
		"@types/express": "^4.17.21",
		"@types/express-serve-static-core": "^5.0.5",
		"@types/http-proxy": "^1.17.15",
		"@types/morgan": "^1.9.9",
		"@types/node": "^22.5.5",
		"@types/react": "^18.2.20",
		"@types/react-dom": "^18.2.7",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/semver": "^7.5.8",
		"@types/tar-fs": "^2.0.4",
		"@types/vhost": "^3.0.9",
		"@types/ws": "^8.5.12",
		"@vitejs/plugin-vue": "^5.2.1",
		"autoprefixer": "^10.4.20",
		"dts-bundle-generator": "^9.5.1",
		"esbuild": "^0.24.0",
		"postcss": "^8.4.45",
		"tailwindcss": "^3.4.11",
		"tsx": "^4.19.1",
		"typescript": "^5.6.2",
		"vite": "^5.1.0"
	}
}
