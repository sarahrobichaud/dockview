{
	"name": "backend",
	"scripts": {
		"build": "pnpm run build:ts && pnpm run build:copy-views && pnpm run build:css && pnpm run build:client-script",
		"build:copy-views": "cp -r ./src/views ./dist",
		"build:ts": "tsc && tsc-alias",
		"build:css": "npx @tailwindcss/cli -i ./src/styles/main.css -o ./public/styles.css",
		"build:client-script": "rollup --config",
		"start": "node dist/entry.js",
		"dev": "pnpm run '/^watch:.*/'",
		"watch:ts": "tsx watch ./src/entry.ts",
		"watch:css": "npx @tailwindcss/cli -i ./src/styles/main.css -o ./public/styles.css --watch",
		"watch:packages": "concurrently \"pnpm --filter @dockview/react-ssr build:watch\" \"pnpm --filter @dockview/core build:watch\" \"pnpm --filter @dockview/ws build:watch\" \"pnpm --filter @dockview/ui watch\"",
		"watch:client-script": "rollup --config --dev",
		"type-check": "tsc --noEmit -p tsconfig.json"
	},
	"type": "module",
	"dependencies": {
		"@dockview/config-typescript": "workspace:^",
		"@dockview/core": "workspace:^",
		"@dockview/react-ssr": "workspace:^",
		"@dockview/ui": "workspace:^",
		"@dockview/ws": "workspace:^",
		"@tailwindcss/cli": "^4.0.13",
		"clsx": "^2.1.1",
		"cors": "^2.8.5",
		"dockerode": "^4.0.4",
		"ejs": "^3.1.10",
		"express": "^4.21.0",
		"http-proxy": "^1.18.1",
		"morgan": "^1.10.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-syntax-highlighter": "^15.6.1",
		"tailwindcss": "^4.0.13",
		"tar-fs": "^3.0.8",
		"tsc-alias": "^1.8.10",
		"vhost": "^3.0.2"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^28.0.3",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@rollup/plugin-replace": "^6.0.2",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.2",
		"@types/cors": "^2.8.17",
		"@types/dockerode": "^3.3.34",
		"@types/express": "^4.17.21",
		"@types/express-serve-static-core": "^5.0.5",
		"@types/http-proxy": "^1.17.15",
		"@types/morgan": "^1.9.9",
		"@types/node": "^22.5.5",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/tar-fs": "^2.0.4",
		"@types/vhost": "^3.0.9",
		"@vitejs/plugin-vue": "^5.2.1",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.2",
		"dts-bundle-generator": "^9.5.1",
		"esbuild": "^0.24.0",
		"express-static-gzip": "^2.2.0",
		"rollup": "^4.35.0",
		"rollup-plugin-gzip": "^4.0.1",
		"tsx": "^4.19.1",
		"typescript": "^5.8.2"
	}
}
