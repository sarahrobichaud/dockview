{
	"name": "backend",
	"scripts": {
		"build": "pnpm run build:ts && pnpm run build:copy-views && pnpm run build:css && pnpm run build:client-script",
		"build:copy-views": "cp -r ./src/views ./dist",
		"build:ts": "tsc && tsc-alias",
		"build:css": "npx tailwindcss -i ./src/assets/globals.css -o ./public/styles.css",
		"build:client-script": "node esbuild.config.mjs",
		"start": "node dist/entry.js",
		"dev": "concurrently \"pnpm run watch:ts\" \"pnpm run watch:packages\" \"pnpm run watch:css\" \"pnpm run watch:client-script\"",
		"watch:ts": "tsx watch ./src/entry.ts",
		"watch:css": "npx tailwindcss -i ./src/assets/globals.css -o ./public/styles.css --watch",
		"watch:packages": "concurrently \"pnpm --filter @dockview/core build:watch\" \"pnpm --filter @dockview/ws build:watch\" \"pnpm --filter @dockview/ui build:watch\"",
		"watch:client-script": "node esbuild.config.mjs --dev",
		"type-check": "tsc --noEmit -p tsconfig.json"
	},
	"type": "module",
	"dependencies": {
		"@dockview/config-typescript": "workspace:^",
		"@dockview/core": "workspace:^",
		"@dockview/ui": "workspace:^",
		"@dockview/ws": "workspace:^",
		"clsx": "^2.1.1",
		"cors": "^2.8.5",
		"dockerode": "^4.0.4",
		"ejs": "^3.1.10",
		"express": "^4.21.0",
		"http-proxy": "^1.18.1",
		"morgan": "^1.10.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-syntax-highlighter": "^15.6.1",
		"tar-fs": "^3.0.8",
		"tsc-alias": "^1.8.10",
		"vhost": "^3.0.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/dockerode": "^3.3.34",
		"@types/express": "^4.17.21",
		"@types/express-serve-static-core": "^5.0.5",
		"@types/http-proxy": "^1.17.15",
		"@types/morgan": "^1.9.9",
		"@types/node": "^22.5.5",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/tar-fs": "^2.0.4",
		"@types/vhost": "^3.0.9",
		"@vitejs/plugin-vue": "^5.2.1",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.2",
		"dts-bundle-generator": "^9.5.1",
		"esbuild": "^0.24.0",
		"postcss": "^8.4.45",
		"tailwindcss": "^3.4.11",
		"tsx": "^4.19.1",
		"typescript": "^5.6.2"
	}
}
