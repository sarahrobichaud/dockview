{
	"extends": "@dockview/config-typescript/tsconfig.node",
	"compilerOptions": {
		"outDir": "./public",
		"rootDir": "src",
		"baseUrl": ".",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"declaration": false,
		"sourceMap": false,
		"declarationMap": false,
		"jsx": "react-jsx",
		"paths": {
			"~/*": ["src/*"],
			"@routes/*": ["src/routes/*"],
			"@utils/*": ["src/utils/*"],
			"@models/*": ["src/models/*"],
			"@controllers/*": ["src/controllers/*"],
			"@middlewares/*": ["src/middlewares/*"]
		},
		"noEmit": true,
		"types": ["./src/types/lib/window.d.ts"]
	},
	"tsc-alias": {
		"resolveFullPaths": true,
		"verbose": false
	},
	"include": ["src/client/**/*", "src/lib/filetree-builder/**/*"],
	"exclude": ["node_modules", "dist"]
}
