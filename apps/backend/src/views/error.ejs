<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Dockview</title>
    <link href="/styles.css" rel="stylesheet" />
</head>

<body class="flex justify-center bg-black text-white items-center h-screen">
    <div class="py-10">
        <h1 class="text-4xl font-bold flex justify-between items-center">
            Dockview Error
            <span class="text-red-600">
                <%= error.statusCode || 500 %>
            </span>
        </h1>
        <h2 class="font-mono border-b text-xl border-gray-500 py-4">
            <%= error.message || 'Something went wrong!' %>
        </h2>

        <% if (process.env.NODE_ENV==='development' && error.stack) { %>
            <div class="error-details text-red-600 py-4">
                <pre><%= error.stack %></pre>
            </div>
            <% } %>
    </div>
</body>

</html>