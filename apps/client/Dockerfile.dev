FROM node:20-slim

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Copy package files from root
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

## Copy package files from other apps
COPY apps/client/package.json ./apps/client/
COPY packages/ws/package.json ./packages/ws/
COPY packages/core/package.json ./packages/core/

# Set up for container-specific node_modules
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Install dependencies
RUN pnpm install

# Set environment variables
ENV NODE_ENV=development
ENV VITE_DEV_SERVER_HOST=0.0.0.0
ENV VITE_DEV_SERVER_PORT=3100

# Expose ports (Vite default + HMR)
EXPOSE 3100
EXPOSE 24678

# Start development server
CMD ["pnpm", "--filter", "client", "dev"] 